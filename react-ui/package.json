{
  "name": "react-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:android": "vite build --mode android",
    "android:build": "npm run build:android && npx cap sync android",
    "android:debug": "npm run build:android && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build:android && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:bundle": "npm run build:android && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@stomp/stompjs": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^3.1.0",
    "sockjs-client": "^1.6.1",
    "telegraf": "^4.16.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.62.2"
  }
}
