# Copy this file to backend/.env and update values for your machine.
# Spring Boot imports backend/.env automatically when run from the backend folder.

MONGODB_URI=mongodb://localhost:27017/political_sim
PORT=7810

# SMTP Mail Server Configuration (for Password Reset OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
